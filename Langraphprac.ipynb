    "from langchain_core.tools import tool\n",
    "from langchain_google_genai import ChatGoogleGenerativeAI\n",
    "llm = ChatGoogleGenerativeAI(model=\"gemini-3.8-flash\",api_key=\"AQ.------ViSd_HrTQ\") \n",
    "tools = load_tools([\"llm-math\"], llm=llm)\n",
    "\n",
    "\n",
    "@tool\n",
    "def financial_report(company_name:str, revenue:float, expenses:float) -> str:\n",
    "    \"\"\" Generate financial report for a company through netprofit\"\"\"\n",
    "    net_income = revenue - expenses\n",
    "\n",
    "    report = f\"Financial report fo {company_name}:\\n\"\n",
    "    report += f\"Revenue:{revenue}\\n\"\n",
    "    report +=f\"Expenses:{expenses}\\n\"\n",
    "    report +=f\"Net Profit:{net_income}\\n\"\n",
    "    return report"
   ]
  },
